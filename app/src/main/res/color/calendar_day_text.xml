<?xml version="1.0" encoding="utf-8"?>
<!-- CalendarView paints the selected day with colorAccent (= primary here); the day label
     must flip to onPrimary on that state or it reads as dark-on-dark. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorOnPrimary" android:state_activated="true" />
    <item android:color="?attr/colorOnPrimary" android:state_selected="true" />
    <item android:color="?attr/colorOnSurface" />
</selector>
