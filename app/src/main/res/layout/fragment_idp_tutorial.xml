<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <!-- Why -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Uoa.Card.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_circle_help"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="なぜこの設定が必要なの?"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="会津大学の学内システムが、大学公式の統合認証(IdP)によるログインに切り替わりました。このアプリもそれに合わせてログイン方法を対応させています。お手数ですが、最初の設定だけお付き合いください。"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- What happens -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.Uoa.ListRow.Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        style="@style/Widget.Uoa.IconContainer"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_key_round" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Uoa.ListRow.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="大学の統合ログイン(IdP)に接続します" />

                        <TextView
                            style="@style/Widget.Uoa.ListRow.Supporting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="いつものID・パスワードで、会津大学の統合認証システムへ直接ログインします。" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    style="@style/Widget.Uoa.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    style="@style/Widget.Uoa.ListRow.Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        style="@style/Widget.Uoa.IconContainer"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mail" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Uoa.ListRow.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ワンタイムパスワードを求められることがあります" />

                        <TextView
                            style="@style/Widget.Uoa.ListRow.Supporting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="アカウントの設定によっては、ログインの途中でワンタイムパスワードの入力が必要になります。" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- OTP delivery choice -->
        <TextView
            style="@style/Widget.Uoa.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="ワンタイムパスワードの受け取り方法" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_otp_auto"
                    style="@style/Widget.Uoa.ListRow.Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="top"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_otp_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Uoa.ListRow.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="自動で取得する" />

                        <TextView
                            style="@style/Widget.Uoa.ListRow.Supporting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="アプリがメール(stdmsv1)を確認し、ワンタイムパスワードを自動で入力します。バックグラウンド同期がそのまま使えます。" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    style="@style/Widget.Uoa.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/row_otp_manual"
                    style="@style/Widget.Uoa.ListRow.Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="top"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_otp_manual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Uoa.ListRow.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="手動で入力する(既定)" />

                        <TextView
                            style="@style/Widget.Uoa.ListRow.Supporting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="アプリはメールを読み取りません。ワンタイムパスワードが必要な時は、設定画面から自分でログインして入力してください。" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Data handling -->
        <TextView
            style="@style/Widget.Uoa.Notice.Neutral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="入力したID・パスワードは、大学の認証システムへ直接送信されます。開発者のサーバーを経由したり、そこに保存されたりすることはありません。"
            app:drawableStartCompat="@drawable/ic_shield_check"
            app:drawableTint="?attr/colorOnSecondaryContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_start_now"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            tools:text="今すぐログインする" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_later"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="あとで" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
