<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="2dp">

    <TextView
        android:id="@+id/text_day"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Uoa.CalendarDay"
        android:textColor="?attr/colorOnSurface"
        tools:text="7" />

    <!-- iOS と同じく、授業 (primary) と課題の締切 (warning) を日付の下の点で示す。 -->
    <LinearLayout
        android:id="@+id/row_dots"
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_class"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1.5dp"
            android:background="@drawable/bg_calendar_dot"
            android:backgroundTint="?attr/colorPrimary"
            android:visibility="invisible" />

        <View
            android:id="@+id/dot_assignment"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1.5dp"
            android:background="@drawable/bg_calendar_dot"
            android:backgroundTint="@color/warning"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
