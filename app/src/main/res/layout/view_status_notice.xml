<?xml version="1.0" encoding="utf-8"?>
<!-- サーバー側の status_notice フラグを表示する非ブロッキングの常時バナー。
     学務システム連携の障害など、アプリ更新なしで周知したい告知に使う (iOS の StatusNoticeBanner)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/status_notice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notice"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:paddingVertical="4dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_info"
        app:tint="@color/on_warning_container" />

    <TextView
        android:id="@+id/status_notice_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingVertical="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/on_warning_container"
        tools:text="@string/maintenance_default_message" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/status_notice_dismiss"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/status_notice_dismiss"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/on_warning_container" />
</LinearLayout>
