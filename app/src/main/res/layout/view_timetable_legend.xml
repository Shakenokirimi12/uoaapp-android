<?xml version="1.0" encoding="utf-8"?>
<!-- 表の下の凡例。iOS の TimetableLegend と同じ。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:layout_width="18dp"
        android:layout_height="14dp"
        android:background="@drawable/bg_timetable_legend_same" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/timetable_legend_same"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <View
        android:layout_width="18dp"
        android:layout_height="14dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_timetable_legend_free" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/timetable_legend_free"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
