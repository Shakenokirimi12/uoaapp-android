<?xml version="1.0" encoding="utf-8"?>
<!-- メンテナンスモードと強制更新の全面表示。ユーザー操作では閉じられない。
     どちらを出すかは MainActivity がタイトル・本文・ボタンを差し替えて決める。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blocking_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:padding="24dp"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/blocking_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_icon_container"
                android:contentDescription="@null"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info"
                app:tint="?attr/colorOnSecondaryContainer" />

            <TextView
                android:id="@+id/blocking_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="@string/maintenance_title" />

            <TextView
                android:id="@+id/blocking_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="@string/maintenance_default_message" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/blocking_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                tools:text="@string/maintenance_recheck" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
