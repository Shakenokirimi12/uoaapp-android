<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 以降のバックアップと機種変更時の転送 (android:dataExtractionRules)。
   除外理由は backup_rules.xml と同じ。ファイル名は PreferenceManager.SECURE_PREF_NAME と一致させること。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="uoa_app_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="uoa_app_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
