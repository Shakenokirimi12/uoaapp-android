<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 以前の自動バックアップ (android:fullBackupContent)。
   暗号化 prefs は Keystore の鍵と一緒でないと復号できず、鍵は端末の外へ出ない。ファイルだけ復元されると
   開けなくなるので除外する (中身はパスワードと IdP/SP のセッション cookie)。
   ファイル名は PreferenceManager.SECURE_PREF_NAME と一致させること。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="uoa_app_secure_prefs.xml" />
</full-backup-content>
