<?xml version="1.0" encoding="utf-8"?>
<!--
  Zen Kaku Gothic New (SIL OFL 1.1, licenses/OFL-ZenKakuGothicNew.txt), subset to Latin,
  kana, JIS kanji and common symbols with fonttools. Chosen over the system Noto Sans CJK
  because it keeps Latin and kana on one rhythm and reads calmer at small sizes.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/zen_kaku_gothic_new_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/zen_kaku_gothic_new_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/zen_kaku_gothic_new_bold" android:fontStyle="normal" android:fontWeight="700" />
</font-family>
