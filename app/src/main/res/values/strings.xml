    <string name="onboarding_password_hint">パスワード</string>
    <string name="onboarding_login_button">ログイン</string>
    <string name="onboarding_pc_relay_later_note">使わない場合は「あとで」をタップしてください。あとから設定の「ログインとワンタイムパスワード」の「PC との連携」で連携できます。</string>
