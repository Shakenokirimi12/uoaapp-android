<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 tonal palette generated from the brand teal (#008578) with the
  tonal-spot scheme. Layouts should reference theme attributes (?attr/colorPrimary,
  ?attr/colorOnSurface, ...) rather than these names; the md_* names exist for the
  theme, the legacy names at the bottom keep old code (R.color.primary etc.) working.
-->
<resources>
    <color name="md_primary">#1F6A60</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#A9F0E3</color>
    <color name="md_on_primary_container">#075C53</color>
    <color name="md_secondary">#4B645F</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#CCE8E2</color>
    <color name="md_on_secondary_container">#3D5752</color>
    <color name="md_tertiary">#336578</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#B5E7FD</color>
    <color name="md_on_tertiary_container">#225668</color>
    <color name="md_error">#A83836</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#6E0A12</color>
    <color name="md_background">#F6FAF8</color>
    <color name="md_on_background">#2A3432</color>
    <color name="md_surface">#F6FAF8</color>
    <color name="md_on_surface">#2A3432</color>
    <color name="md_surface_variant">#DAE5E1</color>
    <color name="md_on_surface_variant">#56615F</color>
    <color name="md_outline">#727D7A</color>
    <color name="md_outline_variant">#A9B4B1</color>
    <color name="md_inverse_surface">#2A3432</color>
    <color name="md_inverse_on_surface">#EEF5F2</color>
    <color name="md_inverse_primary">#9CD1C7</color>
    <color name="md_surface_dim">#D1DCD9</color>
    <color name="md_surface_bright">#F6FAF8</color>
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#EEF5F2</color>
    <color name="md_surface_container">#E7F0ED</color>
    <color name="md_surface_container_high">#E1EAE7</color>
    <color name="md_surface_container_highest">#DAE5E1</color>
    <color name="md_surface_tint">#1F6A60</color>

    <!-- Semantic accents that M3 has no role for. -->
    <color name="warning">#8A5A00</color>
    <color name="warning_container">#FFE1A8</color>
    <color name="on_warning_container">#3D2800</color>
    <color name="success">#2E6B3A</color>
    <color name="success_container">#BDEFC3</color>
    <color name="rating_star">#E0A100</color>

    <!-- Legacy names kept for Java code and layouts not yet migrated. -->
    <color name="primary">@color/md_primary</color>
    <color name="primary_dark">#134F47</color>
    <color name="primary_light">@color/md_primary_container</color>
    <color name="accent">@color/md_tertiary</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="background">@color/md_background</color>
    <color name="surface">@color/md_surface_container_lowest</color>
    <color name="on_primary">@color/md_on_primary</color>
    <color name="on_surface">@color/md_on_surface</color>
    <color name="text_primary">@color/md_on_surface</color>
    <color name="text_secondary">@color/md_on_surface_variant</color>
    <color name="divider">@color/md_outline_variant</color>
    <color name="error">@color/md_error</color>
    <color name="nav_icon_inactive">@color/md_on_surface_variant</color>
</resources>
